# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp Business API Configuration
WHATSAPP_ACCESS_TOKEN=your-system-user-token       # Token de System User (no expira)
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id      # ID del número real registrado en WABA
WHATSAPP_APP_SECRET=your-app-secret                # Configuración > Básica en Meta for Developers
WHATSAPP_VERIFY_TOKEN=your-verify-token            # Cualquier string secreto que elijas
WHATSAPP_DEFAULT_USER_ID=your-supabase-user-id     # UUID del usuario en Supabase
WHATSAPP_ALLOWED_NUMBERS=5491112345678,5491198765432  # Números autorizados (sin + ni espacios). Vacío = todos.
